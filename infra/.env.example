# Somente desenvolvimento local. Nenhum valor aqui é segredo real.
# O docker-compose usa estes mesmos valores como padrão; copie para .env só para mudar.

POSTGRES_DB=ctcore
POSTGRES_USER=ctcore
POSTGRES_PASSWORD=ctcore_dev
POSTGRES_PORT=5432
DB_RUNTIME_USER=ctcore_app
DB_RUNTIME_PASSWORD=ctcore_app_dev
# Flyway: DB_MIGRATION_USER/PASSWORD; por padrão usa POSTGRES_USER/PASSWORD.

STORAGE_PORT=8333

MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
